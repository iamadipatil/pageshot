{
  "manifest_version": 3,
  "name": "Zen Page Shot",
  "short_name": "ZenPageShot",
  "version": "1.1.0",
  "description": "Capture an entire web page locally, then download PNG, JPG, or PDF. One click, no account, nothing uploaded.",
  "minimum_chrome_version": "109",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zen Page Shot — capture this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting"]
}
